{
    "name": "getwebspace/platform",
    "description": "Content Management System",
    "authors": [
        {
            "name": "Aleksey Ilyin",
            "email": "alksily@outlook.com",
            "homepage": "https://alksily.github.io/alksily/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-posix": "*",
        "slim/slim": "^4.15.2",
        "slim/psr7": "^1.7.0",
        "slim/twig-view": "^3.4.0",
        "slim/http-cache": "^1.2.0",
        "php-di/php-di": "^7.0.7",
        "illuminate/events": "^13.29",
        "illuminate/database": "^13.29",
        "illuminate/collections": "^13.29",
        "illuminate/filesystem": "^13.29",
        "illuminate/cache": "^13.29",
        "firebase/php-jwt": "^7.1",
        "alksily/support": "^2.0.0",
        "twig/twig": "^3.28",
        "twig/intl-extra": "^3.26",
        "twig/string-extra": "^3.24",
        "ramsey/uuid": "^4.9.3",
        "phpmailer/phpmailer": "^7.1",
        "phpoffice/phpspreadsheet": "^3.8.0",
        "bacon/bacon-qr-code": "^3.1",
        "monolog/monolog": "^3.10",
        "symfony/var-dumper": "^8.1",
        "voku/html-compress-twig": "^4.0.2",
        "robmorgan/phinx": "^0.16.12",
        "teamtnt/tntsearch": "^4.4"
    },
    "require-dev": {
        "fakerphp/faker": "^2.0.x-dev",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.3",
        "guzzlehttp/guzzle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\": "plugin/",
            "App\\": "src/"
        },
        "files": [
            "config/vars.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    }
}
