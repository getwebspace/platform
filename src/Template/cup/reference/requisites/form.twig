{% extends 'cup/layout.twig' %}

{% block breadcrumb %}
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            {% include 'cup/form-header.twig' with {
                'item': item,
                'create': 'Create new requisites',
                'update': 'Edit requisites'
            } only %}
        </div>
    </div>
{% endblock %}

{% block content %}
    {# value key => [label, placeholder, width of the column] #}
    {% set fields = {
        'legal_name': ['Legal name', '', 12],
        'tax_id': ['Tax ID', '7701234567', 4],
        'tax_reason': ['Tax registration reason code', '770101001', 4],
        'reg_id': ['Registration number', '1027700000000', 4],
        'address': ['Legal address', '', 12],
        'director': ['Director', '', 12],
        'bank': ['Bank', '', 6],
        'bank_id': ['Bank identifier (BIC)', '044525225', 6],
        'account': ['Account number', '', 6],
        'corr_account': ['Correspondent account', '', 6],
        'email': ['E-mail', '', 6],
        'phone': ['Phone', '', 6],
    } %}

    <form method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                {% include 'cup/form.twig' with {
                                    'label': 'Title'|locale,
                                    'type': 'text',
                                    'name': 'title',
                                    'args': {
                                        'required': true,
                                        'value': item.title,
                                    }
                                } %}
                            </div>
                        </div>

                        <div class="row">
                            {% for key, field in fields %}
                                <div class="col-md-{{ field[2] }}">
                                    {% include 'cup/form.twig' with {
                                        'label': field[0]|locale,
                                        'type': 'text',
                                        'name': 'value[' ~ key ~ ']',
                                        'args': {
                                            'value': item.value[key],
                                            'placeholder': field[1],
                                        }
                                    } %}
                                </div>
                            {% endfor %}
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                {% include 'cup/form.twig' with {
                                    'label': 'Enabled'|locale,
                                    'type': 'select',
                                    'name': 'status',
                                    'args': {
                                        'option': _(['yes', 'no']),
                                        'selected': item is null or item.status ? 'yes' : 'no'
                                    }
                                } %}
                            </div>
                            <div class="col-md-6">
                                {% include 'cup/form.twig' with {
                                    'label': 'Sort order'|locale,
                                    'type': 'number',
                                    'name': 'order',
                                    'args': {
                                        'value': item.order is not empty ? item.order : list.count() + 1,
                                        'placeholder': '1',
                                        'min': '1'
                                    }
                                } %}
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        {% include "cup/form-save.twig" %}
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
