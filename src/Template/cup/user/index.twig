{% extends 'cup/layout.twig' %}

{% block breadcrumb %}
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">{{ 'List of users'|locale }} ({{ list.count() }})</h2>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex flex-wrap align-items-center" style="gap: 8px">
                        {% include 'cup/filterbar.twig' with {
                            'fields': [
                                {'type': 'search', 'name': 'q', 'value': q, 'label': 'Search'|locale, 'placeholder': ('Login'|locale) ~ ' / E-Mail / ' ~ ('Phone'|locale) ~ ' / ' ~ ('Full name'|locale)},
                                {'type': 'select', 'name': 'group_uuid', 'label': 'Group'|locale, 'value': group, 'options': {'': 'Group'|locale}|merge(groups.pluck('title', 'uuid').all())},
                                {'type': 'select', 'name': 'state', 'label': 'Status'|locale, 'value': state, 'default': 'work', 'options': {'work': 'Active'|locale, 'block': 'Banned'|locale, 'confirmation': 'Awaiting confirmation'|locale, 'delete': 'Deleted'|locale, 'all': 'All'|locale}},
                            ],
                            'reset': '/cup/user',
                            'active': (q ? 1 : 0) + (group ? 1 : 0) + (state != 'work' ? 1 : 0),
                        } %}

                        <a href="/cup/user/add" class="btn btn-primary btn-round">
                            <i class="fa fa-plus"></i>
                            {{ 'Create user'|locale }}
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% embed 'mixin/datatable.twig' %}
                        {% block thead %}
                            <div class="col-sm-2 d-none d-sm-block" data-sort="text">{{ 'Login'|locale }}</div>
                            <div class="col-12 col-sm" data-sort="text">{{ 'Full name'|locale }}</div>
                            <div class="col-6 col-sm">{{ 'Phone & E-Mail'|locale }}</div>
                            <div class="col-sm-1 d-none d-sm-block" data-sort="text">{{ 'Group'|locale }}</div>
                            <div class="col-6 col-sm-4 text-right"></div>
                        {% endblock %}

                        {% block tbody %}
                            {% for user in list %}
                                <div class="row
                                    {{
                                        user.status == constant('/App/Domain/Casts/User/Status::DELETE')
                                        ? 'bg-danger'
                                        : (
                                            user.status == constant('/App/Domain/Casts/User/Status::BLOCK')
                                            ? 'bg-warning'
                                            : (
                                                user.status == constant('/App/Domain/Casts/User/Status::CONFIRMATION')
                                                ? 'bg-light'
                                                : ''
                                            )
                                        )
                                    }}
                                ">
                                    <div class="col-sm-2 d-none d-sm-block">{{ user.username ?: '<code>&mdash;</code>'|raw }}</div>
                                    <div class="col-12 col-sm">
                                        <span class="d-none d-xl-inline">{{ user.name('full')|u.truncate(25, '...') ?: '<code>&mdash;</code>'|raw }}</span>
                                        <span class="d-xl-none">{{ user.name('name') ?: '<code>&mdash;</code>'|raw }}</span>
                                    </div>
                                    <div class="col-6 col-sm">
                                        <div class="float-left">
                                            {{ user.phone ? (user.phone ~ '<br>')|raw : '' }}
                                            {{ user.email ? (user.email ~ '<br>')|raw : '' }}
                                        </div>

                                        <div class="text-black-50 float-right d-none d-lg-inline">
                                            {% if user.is_allow_mail %}
                                                <i class="fa fa-envelope" data-toggle="tooltip" data-placement="right" title="{{ 'Subscribed to newsletter'|locale }}"></i>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-sm-1 d-none d-sm-block">{{ user.group.title|u.truncate(10, '.') ?? ('<code>' ~ ('Without group'|locale) ~ '</code>')|raw }}</div>
                                    <div class="col-6 col-sm-4 text-right">
                                        <form action="/cup/user/{{ user.uuid }}/delete" style="display: inline-block" method="post" onsubmit="return confirm('{{ 'Are you sure you want to delete the user?'|locale }}');">
                                            <div class="btn-group">
                                                <a href="/cup/user/{{ user.uuid }}/view" class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-address-card"></i>
                                                    <span class="d-none d-md-inline-block">{{ 'View'|locale }}</span>
                                                </a>
                                                <a href="/cup/user/{{ user.uuid }}/edit" class="btn btn-sm btn-info" title="{{ 'Change'|locale }}">
                                                    <i class="fas fa-fw fa-edit"></i>
                                                </a>
                                                {% if user.status != constant('/App/Domain/Casts/User/Status::DELETE') %}
                                                    <button type="submit" class="btn btn-sm btn-danger" title="{{ 'Delete'|locale }}">
                                                        <i class="fas fa-fw fa-trash-alt"></i>
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
