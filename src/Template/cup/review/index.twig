{% extends 'cup/layout.twig' %}

{% block breadcrumb %}
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">{{ context.title|locale }} ({{ list.count() }})</h2>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    {% embed 'mixin/datatable.twig' %}
                        {% block thead %}
                            <div class="col-4 col-md-2">{{ 'Status'|locale }}</div>
                            <div class="col-8 col-md">{{ 'Author'|locale }}</div>
                            <div class="col-6 col-md-2">{{ 'Added date'|locale }}</div>
                            <div class="col-6 col-md-3 text-right"></div>
                        {% endblock %}

                        {% block tbody %}
                            {% for item in list %}
                                <div class="row">
                                    <div class="col-4 col-md-2">
                                        <span class="badge badge-default">{{ item.status|locale }}</span>
                                    </div>
                                    <div class="col-8 col-md">
                                        <b>{{ item.user ? item.user.name : '—' }}</b>

                                        {% if item.type == 'review' and item.rating %}
                                            <span class="text-warning ml-1">
                                                {% for i in 1..5 %}<i class="fa{{ i <= item.rating ? 's' : 'r' }} fa-star"></i>{% endfor %}
                                            </span>
                                        {% endif %}

                                        <div class="text-muted text-small">{{ item.message|slice(0, 160) }}</div>

                                        {% if item.children.count() %}
                                            <div class="text-success text-small">
                                                <i class="fas fa-reply"></i> {{ 'Answer'|locale }}: {{ item.children.first.message|slice(0, 120) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <span class="d-none d-md-inline">{{ item.date|df('d.m.Y H:i') }}</span>
                                        <span class="d-inline d-md-none">{{ item.date|df('d.m.y') }}</span>
                                    </div>
                                    <div class="col-6 col-md-3 text-right">
                                        <form action="{{ context.path }}/{{ item.uuid }}/delete" style="display: inline-block" method="post" onsubmit="return confirm('{{ 'Are you sure you want to delete the entry?'|locale }}');">
                                            <div class="btn-group">
                                                <a href="{{ context.path }}/{{ item.uuid }}/edit" class="btn btn-sm btn-info">
                                                    <i class="fas fa-fw fa-edit"></i>
                                                    <span class="d-none d-md-inline-block">{{ 'Change'|locale }}</span>
                                                </a>
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-fw fa-trash-alt"></i>
                                                    <span class="d-none d-md-inline-block">{{ 'Delete'|locale }}</span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
