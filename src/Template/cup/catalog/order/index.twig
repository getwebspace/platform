{% extends 'cup/layout.twig' %}

{% block breadcrumb %}
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">{{ 'List of orders'|locale }} ({{ list.count() }})</h2>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <form method="get">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 col-md-3">
                                {% include 'cup/form.twig' with {
                                    'label': 'Date From'|locale,
                                    'type': 'date',
                                    'name': 'date[from]',
                                    'args': {
                                        'value': date.from
                                    }
                                } %}
                            </div>
                            <div class="col-6 col-md-3">
                                {% include 'cup/form.twig' with {
                                    'label': 'Date To'|locale,
                                    'type': 'date',
                                    'name': 'date[to]',
                                    'args': {
                                        'value': date.to
                                    }
                                } %}
                            </div>

                            <div class="col-6 col-md-3">
                                {% include 'cup/form.twig' with {
                                    'label': 'Status'|locale,
                                    'type': 'select',
                                    'name': 'status',
                                    'args': {
                                        'option': {'': '---'}|merge(status_list.pluck('title', 'uuid').all()),
                                        'selected': status,
                                    }
                                } %}
                            </div>
                            <div class="col-6 col-md-3">
                                {% include 'cup/form.twig' with {
                                    'label': 'Payment method'|locale,
                                    'type': 'select',
                                    'name': 'payment',
                                    'args': {
                                        'option': {'': '---'}|merge(payment_list.pluck('title', 'uuid').all()),
                                        'selected': payment,
                                    }
                                } %}
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        <div class="btn-group">
                            <button type="submit" class="btn btn-primary">{{ 'Search'|locale }}</button>
                        </div>
                        <div class="btn-group ml-2">
                            {% set today = 'now'|date('Y-m-d') %}
                            <a href="?{{ {'status': status, 'payment': payment, 'date': {'from': today, 'to': today}}|url_encode }}" class="btn btn-secondary">{{ 'Today'|locale }}</a>
                            <a href="?{{ {'status': status, 'payment': payment, 'date': {'from': '-6 days'|date('Y-m-d'), 'to': today}}|url_encode }}" class="btn btn-secondary">{{ 'Week'|locale }}</a>
                            <a href="?{{ {'status': status, 'payment': payment, 'date': {'from': 'first day of this month'|date('Y-m-d'), 'to': today}}|url_encode }}" class="btn btn-secondary">{{ 'Month'|locale }}</a>
                        </div>
                        <a href="/cup/catalog/order" class="btn btn-link">{{ 'Reset'|locale }}</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <a href="{{ path_for('cup:catalog:order:export', [], {'status': status}|merge(date)) }}" class="btn btn-secondary btn-icon ml-auto text-white" data-toggle="tooltip" data-placement="top" title="{{ 'Export current order list'|locale }}">
                            <i class="fas fa-file-export"></i>
                        </a>

                        <a href="/cup/catalog/order/add" class="btn btn-primary btn-round ml-1">
                            <i class="fa fa-plus"></i>
                            {{ 'Create order'|locale }}
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    {% embed 'mixin/datatable.twig' with {'bulk': true} %}
                        {% block thead %}
                            <div class="col-4 col-sm-1" data-sort="num">#</div>
                            <div class="col-5 col-sm" data-sort="text">{{ 'Client'|locale }}</div>
                            <div class="col-3 col-sm-2"></div>
                            <div class="col-6 col-sm-2" data-sort="date">{{ 'Added date'|locale }}</div>
                            <div class="col-6 col-sm-4 text-right"></div>
                        {% endblock %}

                        {% block tbody %}
                            {% for item in list.sortByDesc('Date') %}
                                <div class="row">
                                    <div class="col-4 col-sm-1">
                                        <b>{{ item.serial }}</b>
                                        {% if item.external_id %}
                                            <br/>{{ item.external_id }}
                                        {% endif %}
                                    </div>
                                    <div class="col-5 col-sm">
                                        {% if item.user %}
                                            <a href="/cup/user/{{ item.user_uuid }}/view">
                                                <span class="d-none d-md-inline">{{ item.delivery.client }}</span>
                                                <span class="d-inline d-md-none">{{ item.delivery.client|u.truncate(25, '..') }}</span>
                                            </a>
                                        {% else %}
                                            <span class="d-none d-md-inline">{{ item.delivery.client }}</span>
                                            <span class="d-inline d-md-none">{{ item.delivery.client|u.truncate(25, '..') }}</span>
                                        {% endif %}
                                        <span class="d-none">{{ item.delivery.client }}</span>
                                    </div>
                                    <div class="col-3 col-sm-2">
                                        {% if item.payment_uuid %}
                                            <span class="d-block badge badge-text">{{ item.payment.title }}</span>
                                        {% endif %}
                                        {% if item.status_uuid %}
                                            <span class="d-block badge badge-secondary">{{ item.status.title }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="col-6 col-sm-2">
                                        {{ item.date|df('d.m.Y H:i') }}
                                    </div>
                                    <div class="col-6 col-sm-4 text-right">
                                        <form action="/cup/catalog/order/{{ item.uuid }}/delete" style="display: inline-block" method="post" onsubmit="return confirm('{{ 'Are you sure you want to delete the order?'|locale }}');">
                                            <div class="btn-group dropdown">
                                                <a href="/cup/catalog/order/{{ item.uuid }}/edit" class="btn btn-sm btn-info" title="{{ 'Change'|locale }}">
                                                    <i class="fas fa-fw fa-edit"></i>
                                                </a>
                                                <button type="submit" class="btn btn-sm btn-danger" title="{{ 'Delete'|locale }}">
                                                    <i class="fas fa-fw fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
