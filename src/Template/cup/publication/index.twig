{% extends 'cup/layout.twig' %}

{% block breadcrumb %}
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">{{ 'List of publications'|locale }} ({{ publications.count() }})</h2>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <a href="/cup/publication/add" class="btn btn-primary btn-round ml-auto">
                            <i class="fa fa-plus"></i>
                            {{ 'Create publication'|locale }}
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% embed 'mixin/datatable.twig' with {'filters': [{'name': 'category', 'label': 'Category'|locale}]} %}
                        {% block thead %}
                            <div class="col-12 col-sm" data-sort="text">{{ 'Title'|locale }}</div>
                            <div class="col-4 col-sm-2" data-sort="text">{{ 'Author'|locale }}</div>
                            <div class="col-4 col-sm-2" data-sort="date">{{ 'Date of publication'|locale }}</div>
                            <div class="col-4 col-sm-3 text-right"></div>
                        {% endblock %}

                        {% block tbody %}
                            {% for item in publications %}
                                <div class="row" data-f-category="{{ item.category.title }}">
                                    <div class="col-12 col-sm">
                                        {{ item.title|u.truncate(35, '...') }}

                                        <div class="float-right d-none d-md-block">
                                            <span class="badge badge-secondary">{{ item.category.title|u.truncate(20, '...') }}</span>
                                        </div>
                                    </div>
                                    <div class="col-4 col-sm-2">{{ item.user.name('short') }}</div>
                                    <div class="col-4 col-sm-2">
                                        <span class="d-none d-md-inline">{{ item.date|df('d.m.Y H:i') }}</span>
                                        <span class="d-inline d-md-none">{{ item.date|df('d.m.y') }}</span>
                                    </div>
                                    <div class="col-4 col-sm-3 text-right">
                                        <form action="/cup/publication/{{ item.uuid }}/delete" style="display: inline-block" method="post" onsubmit="return confirm('{{ 'Are you sure you want to delete the publication?'|locale }}');">
                                            <div class="btn-group">
                                                <a href="/cup/publication/{{ item.uuid }}/edit" class="btn btn-sm btn-info" title="{{ 'Change'|locale }}">
                                                    <i class="fas fa-fw fa-edit"></i>
                                                </a>
                                                <button type="submit" class="btn btn-sm btn-danger" title="{{ 'Delete'|locale }}">
                                                    <i class="fas fa-fw fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
