                }

                return properties;
            }

            /**
             * Event trigger: a DOM event on window (detail is the data, cart is the second one)
             * and the handler from options
             */
            function triggerEvent(event, data) {
                window.dispatchEvent(new CustomEvent('event:catalog:' + event, {detail: data}));

                // вызывает обработчик
                if (options.events['on:' + event]) {
                    options.events['on:' + event](data, cart);
                }
            }

            /**
             * Cart item grouping
             */
            function groupBy(array, key) {
                return array.reduce((rv, x) => {
                    (rv[x[key]] = rv[x[key]] || []).push(x);
                    return rv;
                }, {});
            }

            function isObject(item) {
                return (item && typeof item === 'object' && !Array.isArray(item));
            }

            /**
             * Merge objects deeply
             */
            function merge(target, ...sources) {
                if (sources.length) {
                    const source = sources.shift();

                    if (isObject(target) && isObject(source)) {
                        for (const key in source) {
                            if (Object.prototype.hasOwnProperty.call(source, key)) {
                                if (isObject(source[key])) {
                                    if (!target[key]) Object.assign(target, {[key]: {}});
                                    merge(target[key], source[key]);
                                } else {
                                    Object.assign(target, {[key]: source[key]});
                                }
                            }
                        }
                    }

                    return merge(target, ...sources);
                }

                return target;
            }
