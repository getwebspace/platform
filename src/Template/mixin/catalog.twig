{# Catalog script #}
{% htmlcompress %}
    <script>
        /* global grecaptcha */
        // simple cart catalog functions, no dependencies (jQuery is not needed)
        (() => {
            const defaults = {
                // localstorage key
                storage: 'catalog-cart',

                // auto init functions
                init: {
                    listeners: true,
                    handlers: true,
                },

                // cart view options
                cart: {
                    // cart column headers
                    columns: [
                        {label: '', attr: 'thumb', view: null, class: null, style: 'width: 10%; text-align: center;'},
                        {label: 'Title', attr: 'title', view: null, class: null, style: null},
                        {label: 'Vendor code', attr: 'vendorcode', view: null, class: null, style: null},
                        {label: '-', attr: 'decrement', view: null, class: null, style: 'width: 10%; text-align: center;'},
                        {label: 'Quantity', attr: 'quantity', view: null, class: null, style: 'width: 15%;'},
                        {label: '+', attr: 'increment', view: null, class: null, style: 'width: 10%; text-align: center;'},
                        {label: 'Cost', attr: 'price', view: null, class: null, style: 'text-align: right;'},
                        {label: 'Total', attr: 'total', view: null, class: null, style: 'text-align: right;'},
                        {label: 'Remove', attr: 'remove', view: null, class: null, style: 'text-align: center;'},
                    ],

                    // showing header
                    columns_header: true,

                    // showing items group title
                    group_header: true,

                    // table style ('table' or 'div')
                    style: 'table',

                    // cart table class
                    class: {
                        table: 'table',
                        container: 'cart-container',
                    },

                    // before redirect
                    delay: 10,

                    // cart handler url
                    url: '',

                    // delivery options view
                    delivery: 'title', // group
                },

                delivery: {
                    // Example:
                    // "Delivery and free condition": [
                    //     {
                    //         "product": "00000000-0000-0000-0000-000000000000", // catalog product with type 'service'
                    //         "condition": "0" // cart total must be great
                    //     },
                    //     {
                    //         "product": "00000000-0000-0000-0000-000000000000",
                    //         "condition": "150"
                    //     }
                    // ],
                },

                payment: {
                    // Example:
                    // "Cash": "00000000-0000-0000-0000-000000000000"
                    // "Card": "00000000-0000-0000-0000-000000000000"
                },

                // item type by default (e.g. 'product')
                item_type: 'product',

                // format settings
                format: {
                    count: {decimalPlaces: 2, thousandsSeparator: ',', decimalSeparator: '.'}, // in item counts
                    price: {decimalPlaces: 2, currencySymbolStart: '$',  currencySymbolEnd: '', thousandsSeparator: ',', decimalSeparator: '.'}, // in item prices and totals
                },

                // default selectors
                selectors: {
                    'item': 'data-catalog-item', // item (e.g. product or service in catalog)
                    'item-attr': 'data-catalog-item-attr', // item attr (price, color, etc)
                    'item-attr-value': 'data-catalog-item-attr-value', // item attr value
                    'item-add': 'data-catalog-item-add', // button add to cart
                    'cart': 'data-catalog-cart', // cart place
                    'cart-delivery': 'data-catalog-cart-delivery', // select delivery
                    'cart-payment': 'data-catalog-cart-payment', // select payment method
                    'cart-data': 'data-catalog-cart-data', // cart data (client field: name, phone, etc)
                    'cart-checkout': 'data-catalog-cart-checkout', // button cart checkout
                    'count-items': 'data-catalog-cart-count', // counter place (count items in cart)
                    'count-total': 'data-catalog-cart-total', // counter place (count total price of items)
                    'count-total-service': 'data-catalog-cart-total-service', // counter place (count total price of service)
                    'count-total-all': 'data-catalog-cart-total-all', // counter place (count total)
                },

                // events handlers
                events: {
                    'on:ready': null, // (cart) => {}
                    'on:cart:add': null, // (new_item, cart) => {}
                    'on:cart:update': null, // (updated_item, cart) => {}
                    'on:cart:remove': null, // (cart) => {}
                    'on:cart:remove:all': null, // (cart) => {}
                    'on:cart:checkout:before': null, // ({FormData}, cart) => {}
                    'on:cart:checkout:after': null, // ({FormData}, cart) => {}
                }
            };

            // private props
            let
                options = {},
                cart = {},
                delivery = null
            ;

            window.catalog = new class {
                constructor(params) {
                    options = merge({}, defaults, params);
                    cart = readCartData();

                    // auto init listeners
                    if (options.init.listeners) {
                        let focus = null;

                        const render = () => {
                            // render delivery options
                            for (const select of queryAll(getSelector('cart-delivery'))) {
                                select.replaceChildren(...this.cartRenderDelivery());
                                select.dispatchEvent(new Event('change', {bubbles: true}));
                            }

                            // render payment options
                            for (const select of queryAll(getSelector('cart-payment'))) {
                                select.replaceChildren(...this.cartRenderPayment());
                            }

                            // render cart
                            for (const place of queryAll(getSelector('cart'))) {
                                place.replaceChildren(this.cartRender());

                                if (focus) {
                                    const input = place.querySelector('[data-uuid="' + focus + '"] [data-attr="quantity"] input');

                                    if (input) {
                                        input.focus();
                                    }
                                }
                            }

                            setCounter('count-items', this.cartCount(false), this.cartCount(true));
                            setCounter('count-total', this.cartTotal(false), this.cartTotal(true, options.item_type));
                            setCounter('count-total-service', this.cartTotal(false, 'service'), this.cartTotal(true, 'service'));
                            setCounter('count-total-all', this.cartTotal(false), this.cartTotal(true, null));
                        };

                        for (const name of ['ready', 'cart:add', 'cart:update', 'cart:remove', 'cart:remove:all']) {
                            window.addEventListener('event:catalog:' + name, render);
                        }

                        // handler focus in cart
                        document.addEventListener('focusin', (e) => {
                            if (e.target.matches && e.target.matches('[data-attr="quantity"] input') && e.target.closest(getSelector('cart'))) {
                                focus = e.target.closest('[data-uuid]').getAttribute('data-uuid');
                            }
                        });
                        document.addEventListener('focusout', (e) => {
                            if (e.target.matches && e.target.matches('[data-attr="quantity"] input')) {
                                focus = null;
                            }
                        });
                    }

                    // auto init handlers
                    if (options.init.handlers) {
                        document.addEventListener('click', (e) => {
                            const add = e.target.closest(getSelector('item-add'));

                            if (add) {
                                const item = add.closest(getSelector('item'));

                                if (item) {
                                    this.cartAddItemFromElement(item);
                                }

                                return;
                            }

                            const checkout = e.target.closest(getSelector('cart-checkout'));

                            if (checkout && !checkout.disabled) {
                                e.preventDefault();
                                e.stopPropagation();

                                this.cartCheckout(queryAll(getSelector('cart-data') + ', ' + getSelector('cart-payment')));
                            }
                        });
                        document.addEventListener('change', (e) => {
                            if (e.target.matches && e.target.matches(getSelector('cart-delivery'))) {
                                const option = e.target.selectedOptions[0];

                                this.changeDelivery(option ? option.dataset.uuid : undefined);
                            }
                        });
                    }

                    // ready
                    const ready = () => setTimeout(() => triggerEvent('ready', cart), 100);

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', ready, {once: true});
                    } else {
                        ready();
                    }
                }

                /**
                 * Return current cart options
                 */
                getOptions() {
                    return options;
                }

                /**
                 * Render cart, returns the root element
                 * @return {HTMLElement}
                 */
                cartRender() {
                    const
                        root = cartRenderEl('root'),
                        table = cartRenderEl('table'),
                        thead = cartRenderEl('thead'),
                        tbody = cartRenderEl('tbody'),
                        items = cartRenderEl('items')
                    ;

                    root.classList.add(...options.cart.class.container.split(' ').filter(Boolean));
                    table.classList.add(...options.cart.class.table.split(' ').filter(Boolean));

                    // table head
                    if (options.cart.columns_header) {
                        for (const column of options.cart.columns) {
                            const th = cartRenderEl('th');

                            th.setAttribute('data-attr', column.attr);
                            th.innerHTML = column.label;
                            decorate(th, column);
                            thead.append(th);
                        }
                    }

                    // table body
                    const grouped = groupBy(cart, 'group');

                    for (const title of Object.keys(grouped)) {
                        // group title
                        if (options.cart.group_header && title) {
                            const tr = cartRenderEl('tr'), td = cartRenderEl('td');

                            tr.setAttribute('data-group', title);
                            tr.setAttribute('data-group-count', grouped[title].length);
                            td.setAttribute('colspan', options.cart.columns.length);
                            td.textContent = title;
                            tr.append(td);
                            tbody.append(tr);
                        }

                        // cart items
                        for (const item of grouped[title]) {
                            if (item.type === options.item_type) {
                                const row = cartRenderEl('tr');

                                row.setAttribute('data-uuid', item.uuid);
                                row.setAttribute('data-type', item.type);

                                for (const column of options.cart.columns) {
                                    const td = cartRenderEl('td');

                                    td.setAttribute('data-label', column.label);
                                    td.setAttribute('data-attr', column.attr);
                                    decorate(td, column);

                                    if (!column.view) {
                                        // draw by column type
                                        switch (column.attr) {
                                            case 'title': {
                                                const span = document.createElement('span');

                                                span.textContent = item.title;
                                                td.append(span);
                                                break;
                                            }
                                            case 'url': {
                                                const a = document.createElement('a');

                                                a.href = item.url;
                                                a.title = item.title;
                                                a.textContent = item.title;
                                                td.append(a);
                                                break;
                                            }
                                            case 'thumb': {
                                                const img = document.createElement('img');

                                                img.src = item.thumb;
                                                img.alt = item.title;
                                                td.append(img);
                                                break;
                                            }
                                            case 'decrement':
                                                td.append(button('-', () => this.cartItemDecrement(item.uuid, 'uuid')));
                                                break;
                                            case 'increment':
                                                td.append(button('+', () => this.cartItemIncrement(item.uuid, 'uuid')));
                                                break;
                                            case 'quantity': {
                                                const input = document.createElement('input');

                                                input.type = 'number';
                                                input.setAttribute('pattern', '[0-9]*');
                                                input.setAttribute('inputmode', 'numeric');
                                                input.step = item.quantity_step || 1;
                                                input.value = formatNumber(item.quantity, {
                                                    ...options.format.count,
                                                    currencySymbolStart: '',
                                                    currencySymbolEnd: '',
                                                    thousandsSeparator: '',
                                                    decimalSeparator: '.'
                                                });
                                                input.addEventListener('change', () => this.cartItemChangeCount(input.value, item.uuid, 'uuid'));
                                                td.append(input);
                                                break;
                                            }
                                            case 'price':
                                                td.textContent = formatNumber(item[item.price_type], options.format.price);
                                                break;
                                            case 'total':
                                                td.textContent = formatNumber(item[item.price_type] * item.quantity, options.format.price);
                                                break;
                                            case 'remove':
                                                td.append(button('×', () => this.cartRemoveItemByField(item.uuid, 'uuid')));
                                                break;
                                            default:
                                                td.textContent = item[column.attr];
                                        }
                                    } else {
                                        // custom view: a string, a node or a function returning one of them
                                        const view = typeof column.view === 'function' ? column.view(item) : column.view;

                                        if (view instanceof Node) {
                                            td.append(view);
                                        } else {
                                            td.innerHTML = view;
                                        }
                                    }

                                    row.append(td);
                                }

                                tbody.append(row);
                            }

                            // append system lines: uuid => quantity, price, price_type
                            items.append(
                                hidden('products[' + item.uuid + '][count]', item.quantity, 'number'),
                                hidden('products[' + item.uuid + '][price]', item[item.price_type], 'number'),
                                hidden('products[' + item.uuid + '][price_type]', item.price_type, 'text')
                            );
                        }
                    }

                    table.append(thead, tbody);
                    root.append(table, items);

                    return root;
                }

                /**
                 * Render select options by rules
                 * @return {HTMLOptionElement[]}
                 */
                cartRenderDelivery() {
                    const select = document.querySelector(getSelector('cart-delivery')), collect = [];

                    if (select) {
                        const selected = select.value, total = this.cartTotal(false);

                        for (const type in options.delivery) {
                            const items = options.delivery[type].sort(
                                (a, b) => parseFloat(b.condition) - parseFloat(a.condition)
                            );

                            for (const item of items) {
                                if (
                                    (typeof item.condition === 'string' && total >= parseFloat(item.condition)) ||
                                    (typeof item.condition === 'boolean' && item.condition.toString() === 'true')
                                ) {
                                    const properties = getItemProperties(document.querySelector(getSelector('item', item.uuid))),
                                        option = document.createElement('option');

                                    option.selected = !!selected && selected === type;
                                    option.dataset.uuid = item.uuid;
                                    option.value = type;
                                    option.textContent = options.cart.delivery === 'title' ? properties.title : type;
                                    collect.push(option);

                                    break;
                                }
                            }
                        }
                    }

                    return collect;
                }

                /**
                 * Render payment select options
                 * @return {HTMLOptionElement[]}
                 */
                cartRenderPayment() {
                    const select = document.querySelector(getSelector('cart-payment')), collect = [];

                    if (select) {
                        const selected = select.value;

                        for (const [uuid, title] of Object.entries(options.payment)) {
                            const option = document.createElement('option');

                            option.selected = !!selected && selected === uuid;
                            option.value = uuid;
                            option.textContent = title;
                            collect.push(option);
                        }
                    }

                    return collect;
                }

                changeDelivery(uuid) {
                    if (this.cartTotal(false)) {
                        if (uuid && uuid !== delivery) {
                            delivery = uuid;

                            // first remove exist
                            for (const type in options.delivery) {
                                for (const item of options.delivery[type]) {
                                    this.cartRemoveItemByField(item.uuid, 'uuid');
                                }
                            }

                            // add item
                            const properties = getItemProperties(document.querySelector(getSelector('item', uuid)));

                            properties['uuid'] = uuid;
                            properties['price_type'] = 'price';
                            properties['quantity'] = 1;

                            this.cartAddItem(properties);
                        }
                    } else if (delivery) {
                        // remove exist
                        for (const type in options.delivery) {
                            for (const item of options.delivery[type]) {
                                this.cartRemoveItemByField(item.uuid, 'uuid');
                            }
                        }

                        delivery = null;
                    }
                }

                /**
                 * Add item to cart by the element of item
                 * @param {Element} element
                 * @return {number}
                 */
                cartAddItemFromElement(element) {
                    return this.cartAddItem(getItemProperties(element));
                }

                /**
                 * Add item to cart (if duplicate - increment quantity)
                 * @param item
                 * @return {number}
                 */
                cartAddItem(item) {
                    let index;
                    const defaults = {
                        'uuid': '',
                        'title': '',
                        'url': '',
                        'thumb': '',
                        'vendorcode': '',
                        'price': 0,
                        'price_wholesale': 0,
                        'price_wholesale_from': 0,
                        'price_self': 0,
                        'price_type': 'price', // price, price_wholesale, price_self
                        'quantity': 1,
                        'quantity_step': 1,
                        'quantity_min': 1,
                        'group': '',
                        'type': options.item_type,
                    };

                    item = merge({}, defaults, item);
                    item['quantity_step'] = item['quantity_step'] ? +item['quantity_step'] : 1;
                    item['quantity_min'] = item['quantity_min'] ? +item['quantity_min'] : 1;
                    item['quantity'] = item['quantity'] >= item['quantity_min'] ? +item['quantity'] : item['quantity_min'];
                    item['price'] = item['price'] ? +item['price'] : 0;
                    item['price_wholesale'] = item['price_wholesale'] ? +item['price_wholesale'] : 0;
                    item['price_wholesale_from'] = item['price_wholesale_from'] ? +item['price_wholesale_from'] : 0;
                    item['price_self'] = item['price_self'] ? +item['price_self'] : 0;
                    item['price_type'] = item['price_type'] === 'price_self' ? 'price_self' : (item['price_wholesale_from'] > 0 && item['quantity'] >= item['price_wholesale_from'] ? 'price_wholesale' : 'price');

                    if ((index = this.cartFindItemByField(item['uuid'], 'uuid')) >= 0) {
                        this.cartItemChangeCountById(index, cart[index].quantity + item['quantity']);
                    } else {
                        cart.push(item);
                        triggerEvent('cart:add', item);
                    }
                    saveCartData(cart);

                    return cart.length;
                }

                // find item index by field value
                cartFindItemByField(value, field = 'uuid') {
                    return cart.findIndex(obj => obj[field] === value);
                }

                // return cart item
                cartGetItemByField(value, field = 'uuid') {
                    const index = this.cartFindItemByField(value, field);

                    return index >= 0 ? cart[index] : null;
                }

                /**
                 * Increment item quantity
                 */
                cartItemIncrement(value, field = 'uuid') {
                    const index = this.cartFindItemByField(value, field);

                    if (index >= 0) {
                        this.cartItemChangeCountById(index, cart[index].quantity + cart[index].quantity_step);
                    }
                }

                /**
                 * Decrement item quantity
                 */
                cartItemDecrement(value, field = 'uuid') {
                    const index = this.cartFindItemByField(value, field);

                    if (index >= 0) {
                        this.cartItemChangeCountById(index, cart[index].quantity - cart[index].quantity_step);
                    }
                }

                /**
                 * Change item quantity
                 */
                cartItemChangeCount(count, value, field = 'uuid') {
                    const index = this.cartFindItemByField(value, field);

                    if (index >= 0) {
                        this.cartItemChangeCountById(index, count);
                    }
                }

                /**
                 * Change item quantity by id
                 */
                cartItemChangeCountById(index, count) {
                    if (index >= 0 && cart[index]) {
                        cart[index].quantity = +count;

                        const {quantity, quantity_min, quantity_step, price_wholesale_from} = cart[index];

                        if (price_wholesale_from > 0 && quantity >= price_wholesale_from) {
                            cart[index].price_type = 'price_wholesale';
                        } else {
                            cart[index].price_type = 'price';
                        }

                        // an item below the minimum (or a broken number) leaves the cart
                        if (!(quantity >= quantity_min)) {
                            this.cartRemoveItemById(index);
                            saveCartData(cart);

                            return;
                        }

                        const difference = quantity - quantity_min;

                        if (difference % quantity_step !== 0) {
                            cart[index].quantity = quantity_min + Math.ceil(difference / quantity_step) * quantity_step;
                        }

                        triggerEvent('cart:update', cart[index]);
                        saveCartData(cart);
                    }
                }

                /**
                 * Remove item from cart by index
                 */
                cartRemoveItemById(index) {
                    if (index >= 0 && cart[index]) {
                        const removed = cart.splice(index, 1);

                        triggerEvent('cart:remove', removed.shift());
                        saveCartData(cart);
                    }
                }

                /**
                 * Remove item from cart by value of field
                 */
                cartRemoveItemByField(value, field = 'uuid') {
                    this.cartRemoveItemById(this.cartFindItemByField(value, field));
                }

                /**
                 * Remove all items from cart
                 */
                cartRemoveAll() {
                    cart = [];
                    triggerEvent('cart:remove:all', cart);
                    saveCartData(cart);
                }

                /**
                 * Count of titles in cart by item_type
                 * @return {string|number}
                 */
                cartCount(ret_str = true) {
                    if (cart.length) {
                        const count = cart.reduce((count, item) => item['type'] === options.item_type ? count + 1 : count, 0);

                        return !ret_str ? count : formatNumber(count, options.format.count);
                    }

                    return 0;
                }

                /**
                 * Total price of items in cart
                 * @return {string|number}
                 */
                cartTotal(ret_str = true, type = options.item_type) {
                    if (cart.length) {
                        const price = cart
                            .filter((el) => type ? el.type === type : true)
                            .map((el) => el.quantity * el[el.price_type])
                            .reduce((a, b) => a + b, 0);

                        return !ret_str ? price : formatNumber(price, options.format.price);
                    }

                    return 0;
                }

                /**
                 * Checkout cart
                 * @param fields list of cart data elements (by selector 'cart-data')
                 * @return {Promise<boolean>} true when the order was accepted by the server
                 */
                async cartCheckout(fields = queryAll(getSelector('cart-data') + ', ' + getSelector('cart-payment'))) {
                    const data = new FormData();
                    let valid = true;

                    for (const el of fields) {
                        if (el.disabled) {
                            continue;
                        }

                        const isCheckable = (el.type === 'checkbox' || el.type === 'radio');

                        // skip unchecked checkbox/radio
                        if (isCheckable && !el.checked) {
                            if (el.required) {
                                el.classList.add('check-error');
                                valid = false;
                            }
                            continue;
                        }

                        // check required fields
                        if (el.required && !isCheckable && !el.value.trim()) {
                            el.classList.add('check-error');
                            valid = false;
                            continue;
                        }

                        // check email field
                        if (el.required && el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) {
                            el.classList.add('check-error');
                            valid = false;
                            continue;
                        }

                        el.classList.remove('check-error');

                        // add value into FormData
                        if (el.value) {
                            data.append(el.name, el.value);
                        }
                    }

                    if (!valid) {
                        return false;
                    }

                    // disable btn
                    const buttons = queryAll(getSelector('cart-checkout')), html = buttons.map((b) => b.innerHTML);

                    buttons.forEach((b) => {
                        b.disabled = true;
                        b.textContent = 'Подождите..';
                    });

                    triggerEvent('cart:checkout:before', data);

                    let accepted = false;

                    try {
                        // Google reCAPTCHA работает если подключен mixin/recaptcha.twig
                        if (typeof (grecaptcha) !== 'undefined' && grecaptcha.getToken) {
                            data.append('recaptcha', await grecaptcha.getToken());
                        }

                        const response = await fetch(options.cart.url || location.pathname, {
                            method: 'POST',
                            body: data,
                            cache: 'no-store',
                            credentials: 'same-origin',
                            // the server answers a plain form post with a redirect, an ajax one with json
                            headers: {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'},
                        });
                        const res = await response.json().catch(() => null);

                        if (res) {
                            if (res.redirect) {
                                accepted = true;
                                triggerEvent('cart:checkout:after', data);

                                // flexibility
                                setTimeout(() => {
                                    this.cartRemoveAll();
                                    location = res.redirect;
                                }, options.cart.delay);
                            } else if (res.errors) {
                                for (const name in res.errors) {
                                    for (const field of queryAll(getSelector('cart-data'))) {
                                        if (field.name === name && field.closest('[data-input]')) {
                                            field.closest('[data-input]').classList.add('has-error');
                                        }
                                    }
                                }
                            }
                        }
                    } finally {
                        // enable btn
                        setTimeout(() => buttons.forEach((b, i) => {
                            b.disabled = false;
                            b.innerHTML = html[i];
                        }), options.cart.delay);
                    }

                    return accepted;
                }
            }(window.catalog || {});

            /**
             * Generate element of cart structure by cart style
             */
            function cartRenderEl(tag) {
                const table = options.cart.style === 'table';
                const map = {
                    root: ['div'],
                    table: [table ? 'table' : 'div'],
                    thead: table ? ['thead'] : ['div', 'row'],
                    th: table ? ['th'] : ['div', 'col'],
                    tbody: [table ? 'tbody' : 'div'],
                    tr: table ? ['tr'] : ['div', 'row'],
                    td: table ? ['td'] : ['div', 'col'],
                    items: ['noindex'],
                };
                const [name, cls] = map[tag];
                const el = document.createElement(name);

                if (cls) {
                    el.className = cls;
                }
                if (tag === 'items') {
                    el.style.display = 'none';
                }

                return el;
            }

            // class and style of a column
            function decorate(el, column) {
                if (column.class) {
                    el.classList.add(...column.class.split(' ').filter(Boolean));
                }
                if (column.style) {
                    el.setAttribute('style', column.style);
                }
            }

            function button(text, onclick) {
                const el = document.createElement('button');

                el.type = 'button';
                el.className = 'btn btn-icon';
                el.textContent = text;
                el.addEventListener('click', onclick);

                return el;
            }

            // hidden cart data field (posted with the order)
            function hidden(name, value, type) {
                const el = document.createElement('input');

                el.setAttribute(options.selectors['cart-data'], '');
                el.type = type;
                el.name = name;
                el.value = value;

                return el;
            }

            function setCounter(selector, value, text) {
                for (const el of queryAll(getSelector(selector))) {
                    el.setAttribute(options.selectors[selector], value);
                    el.textContent = text;
                }
            }

            function queryAll(selector) {
                return Array.from(document.querySelectorAll(selector));
            }

            // the number formatter of wse.js, or the same one when that is not loaded
            function formatNumber(number, format) {
                if (typeof window.formatNumber === 'function') {
                    return window.formatNumber(number, format);
                }

                const {decimalPlaces = 0, currencySymbolStart = '', currencySymbolEnd = '', thousandsSeparator = '', decimalSeparator = ''} = format;
                const [int, fraction] = Math.abs(+number || 0).toFixed(decimalPlaces).split('.');

                return (number < 0 ? '-' : '') + currencySymbolStart
                    + int.replace(/\B(?=(\d{3})+(?!\d))/g, thousandsSeparator)
                    + (fraction ? decimalSeparator + fraction : '') + currencySymbolEnd;
            }

            /**
             * Read cart data from localstorage
             */
            function readCartData() {
                try {
                    const data = JSON.parse(localStorage.getItem(options.storage) || '[]');

                    return Array.isArray(data) ? data : [];
                } catch (e) {
                    return [];
                }
            }

            /**
             * Save cart data to localstorage
             */
            function saveCartData(cart) {
                try {
                    localStorage.setItem(options.storage, JSON.stringify(cart));
                } catch (e) {
                    // private mode or full storage: the cart lives until the page is closed
                }
            }

            /**
             * Generate selector
             */
            function getSelector(selector, value = false) {
                return '[' + options.selectors[selector] + (value ? '="' + value + '"' : '') + ']';
            }

            /**
             * Return item attrs
             * @param {?Element} element
             * @return object
             */
            function getItemProperties(element) {
                const properties = {}, attr = options.selectors['item-attr'];

                if (element) {
                    for (const el of element.querySelectorAll(getSelector('item-attr'))) {
                        properties[el.getAttribute(attr)] = (typeof el.value === 'string' ? el.value : '')
                            || el.textContent
                            || el.getAttribute(options.selectors['item-attr-value'])
                            || '';
