{% set randomId = random() %}

<div class="row">
    <div class="col-12 col-sm-6 col-md-5 col-lg-4 col-xl-3" style="padding-top: 11px">
        {% block tbutton '' %}
        <small class="text-muted" data-table-count="{{ randomId }}"></small>
    </div>
    <div class="col-12 col-sm-6 col-md-5 col-lg-4 col-xl-3 ml-sm-auto">
        {% include 'cup/form.twig' with {
            'type': 'search',
            'args': {
                'placeholder': 'Search'|locale,
                'data': {'table-search': randomId}
            }
        } %}
    </div>
</div>

{% if bulk|default(false) %}
    <div class="row" data-table-bulk="{{ randomId }}" style="display: none">
        <div class="col-12 py-2">
            <span class="mr-2">{{ 'Selected'|locale }}: <b data-bulk-count>0</b></span>
            <button type="button" class="btn btn-sm btn-danger" data-bulk-delete>
                <i class="fas fa-fw fa-trash-alt"></i> {{ 'Delete selected'|locale }}
            </button>
        </div>
    </div>
{% endif %}

<div class="row clusterize-header text-nowrap" data-table-head="{{ randomId }}">
    {% block thead %}
        <div class="col clusterize-no-data text-center">
            {{ 'No headers'|locale }}
        </div>
    {% endblock %}
</div>
<div data-table-scroll="{{ randomId }}" class="clusterize-scroll">
    <div class="clusterize-content text-nowrap" data-table-content="{{ randomId }}" style="display: none;">
        {% block tbody %}
            <div class="row clusterize-no-data text-center">
                <div class="col">
                    {{ 'No data'|locale }}
                </div>
            </div>
        {% endblock %}
    </div>
</div>

<style>
    [data-table-content] .row:has(a.btn-info[href$="/edit"]) { cursor: pointer; }
</style>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
        let $rows = $('[data-table-content="{{ randomId }}"] div.row:not(.clusterize-no-data)').detach();

        (async () => {
            {% if bulk|default(false) %}
            // bulk delete reuses the delete form every row already has, so rights and hooks stay as they are
            $rows.each((i, row) => {
                let form = row.querySelector('form[action$="/delete"]');

                if (form && row.lastElementChild) {
                    row.lastElementChild.insertAdjacentHTML('afterbegin', '<input type="checkbox" data-bulk-row="' + form.getAttribute('action') + '" class="mr-2 align-middle" style="width: 16px; height: 16px">');
                }
            });
            {% endif %}

            await window.loader([
                '/assets/js/plugin/clusterize/clusterize.min.css',
                '/assets/js/plugin/clusterize/clusterize.min.js',
            ]);

            let $scroll = $('[data-table-scroll="{{ randomId }}"]'),
                $content = $('[data-table-content="{{ randomId }}"]');

            // init table
            let clusterize = new Clusterize({
                rows: $rows.map((i, el) => el.outerHTML).toArray(),
                scrollElem: $scroll.get(0),
                contentElem: $content.show().get(0),
                rows_in_block: 25,
                blocks_in_cluster: 3,
                no_data_class: 'text-center pt-3',
                no_data_text: '{{ 'No data'|locale }}'
            });

            // phone as bare digits without the country prefix:
            // "+7 (925) 123-45-67", "89251234567" and "9251234567" become the same
            const phone = (value) => {
                let digits = value.replace(/\D/g, '');

                return digits.length === 11 && /^[78]/.test(digits) ? digits.slice(1) : digits;
            };

            // sorting: a header with data-sort="text|num|date" sorts by the same-index cell of every row
            const parseDate = (value) => {
                let m = value.trim().match(/^(\d{1,2})\.(\d{1,2})\.(\d{2,4})(?:\s+(\d{1,2}):(\d{2}))?/);

                if (!m) {
                    return 0;
                }

                return Date.UTC(m[3].length === 2 ? 2000 + +m[3] : +m[3], m[2] - 1, m[1], m[4] || 0, m[5] || 0);
            };
            const sortKey = (row, col, type) => {
                let cell = row.children[col],
                    text = cell ? cell.innerText.trim() : '';

                if (type === 'num') {
                    return parseFloat(text.replace(/\s/g, '').replace(',', '.').replace(/[^\d.\-]/g, '')) || 0;
                }
                if (type === 'date') {
                    return parseDate(text);
                }

                return text.toLowerCase();
            };
            const collator = new Intl.Collator(undefined, {numeric: true});
            const $heads = $('[data-table-head="{{ randomId }}"] [data-sort]');
            const $count = $('[data-table-count="{{ randomId }}"]');
            let query = '', sort = null;

            $heads.css('cursor', 'pointer').attr('title', '{{ 'Sort'|locale }}').each((i, el) => {
                $(el).append(' <i class="fas fa-sort text-black-50" data-sort-icon></i>');
            });

            // a click on the row itself opens the editor, links, buttons and selected text keep their own behaviour
            $content.on('click', '.row', (e) => {
                if ($(e.target).closest('a, button, input, label, form, select, textarea').length || window.getSelection().toString()) {
                    return;
                }

                let edit = e.currentTarget.querySelector('a.btn-info[href$="/edit"]');

                if (edit) {
                    location.href = edit.getAttribute('href');
                }
            });

            let visible = $rows.toArray();
            {% if bulk|default(false) %}
            const $bar = $('[data-table-bulk="{{ randomId }}"]'),
                $header_last = $('[data-table-head="{{ randomId }}"] > :last-child');

            $header_last.prepend('<input type="checkbox" data-bulk-all class="mr-2 align-middle" style="width: 16px; height: 16px" title="{{ 'Select all'|locale }}">');

            const checked = () => $rows.toArray().filter((row) => row.querySelector('[data-bulk-row][checked]'));
            const refreshBar = () => {
                let n = checked().length;

                $bar.toggle(n > 0).find('[data-bulk-count]').text(n);
                $header_last.find('[data-bulk-all]').prop('checked', visible.length > 0 && visible.every((row) => row.querySelector('[data-bulk-row][checked]')));
            };
            const mark = (row, on) => {
                let box = row.querySelector('[data-bulk-row]');

                if (box) {
                    on ? box.setAttribute('checked', 'checked') : box.removeAttribute('checked');
                }
            };

            // rows are re-rendered from their markup, so the state lives in the `checked` attribute
            $content.on('change', '[data-bulk-row]', (e) => {
                let action = e.currentTarget.getAttribute('data-bulk-row');

                $rows.each((i, row) => {
                    if (row.querySelector('[data-bulk-row]').getAttribute('data-bulk-row') === action) {
                        mark(row, e.currentTarget.checked);
                    }
                });
                refreshBar();
            });
            $header_last.on('change', '[data-bulk-all]', (e) => {
                visible.forEach((row) => mark(row, e.currentTarget.checked));
                clusterize.update(visible.map((row) => row.outerHTML));
                refreshBar();
            });
            $bar.on('click', '[data-bulk-delete]', async (e) => {
                let actions = checked().map((row) => row.querySelector('[data-bulk-row]').getAttribute('data-bulk-row'));

                if (!actions.length || !confirm('{{ 'Delete selected'|locale }}: ' + actions.length + '?')) {
                    return;
                }

                $(e.currentTarget).prop('disabled', true);

                // one by one: SQLite allows a single writer
                for (const action of actions) {
                    await fetch(action, {method: 'POST', credentials: 'same-origin'});
                }

                location.reload();
            });
            {% endif %}

            const render = () => {
                let digits = /^[\d\s()+\-]+$/.test(query) ? query.replace(/\D/g, '') : '',
                    query_phone = digits.length >= 3 ? [...new Set([phone(digits), digits.replace(/^[78]/, '')])] : [],
                    list = [];

                for (let i = 0; i < $rows.length; i++) {
                    let text = $rows[i].innerText.toLowerCase();

                    if (
                        !query
                        || text.includes(query)
                        || (query_phone.length && (text.match(/\+?\d[\d\s()\-]{5,}\d/g) || []).some((item) => query_phone.some((q) => q && phone(item).includes(q))))
                    ) {
                        list.push($rows[i]);
                    }
                }

                if (sort) {
                    let keys = new Map(list.map((row) => [row, sortKey(row, sort.col, sort.type)]));

                    list.sort((a, b) => {
                        let x = keys.get(a), y = keys.get(b),
                            r = typeof x === 'number' ? x - y : collator.compare(x, y);

                        return sort.dir * r;
                    });
                }

                visible = list;
                clusterize.update(list.map((row) => row.outerHTML));
                {% if bulk|default(false) %}refreshBar();{% endif %}
                $count.text(query ? '{{ 'Found'|locale }}: ' + list.length + ' / ' + $rows.length : '');
            };

            $heads.on('click', (e) => {
                let $el = $(e.currentTarget),
                    col = $el.index(),
                    dir = sort && sort.col === col ? -sort.dir : 1;

                sort = {col: col, dir: dir, type: $el.data('sort')};
                $heads.find('[data-sort-icon]').attr('class', 'fas fa-sort text-black-50');
                $el.find('[data-sort-icon]').attr('class', 'fas text-primary ' + (dir > 0 ? 'fa-sort-up' : 'fa-sort-down'));
                render();
            });

            $('[data-table-search="{{ randomId }}"]').on('keyup', (e) => {
                query = e.currentTarget.value.toLowerCase();
                render();
            });
        })();
    });
</script>
